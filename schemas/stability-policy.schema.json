{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simurgh stability policy",
  "type": "object",
  "required": ["version", "publicApi", "prerelease", "experimentalSurfaces"],
  "properties": {
    "version": { "const": 1 },
    "publicApi": {
      "type": "object",
      "required": ["minimumDeprecationNoticeDays", "minimumDeprecationMinorReleases", "supportedStableMinorLines", "securitySupportMonths"]
    },
    "prerelease": {
      "type": "object",
      "required": ["supportedMinorLines", "breakingReleaseLevel"]
    },
    "experimentalSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
