{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Icon discovery evidence policy",
  "type": "object",
  "required": ["version", "collectionMode", "productTelemetryEnabled", "consentRequired", "participantIdentifier", "rawDataRetentionDays", "minimumPublishedCohortSize", "prohibitedFields", "metrics"],
  "properties": {
    "version": { "const": 1 },
    "collectionMode": { "const": "moderated-structured-study" },
    "productTelemetryEnabled": { "const": false },
    "consentRequired": { "const": true },
    "participantIdentifier": { "const": "random-session-code" },
    "rawDataRetentionDays": { "type": "integer", "minimum": 1, "maximum": 30 },
    "minimumPublishedCohortSize": { "type": "integer", "minimum": 5 },
    "prohibitedFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "metrics": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
