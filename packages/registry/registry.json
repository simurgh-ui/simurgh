{
  "$schema": "https://simurgh-ui.dev/schema/registry.json",
  "name": "simurgh",
  "version": "0.1.0",
  "components": ["dialog", "popover", "tooltip", "dropdown-menu", "select", "tabs", "accordion", "checkbox", "switch", "toast"],
  "frameworks": {
    "react": { "extension": "tsx", "source": "packages/react/src/index.tsx", "dependencies": ["@floating-ui/react", "@simurgh-ui/core"] },
    "vue": { "extension": "ts", "source": "packages/vue/src/index.ts", "dependencies": ["@floating-ui/dom", "@simurgh-ui/core"] },
    "angular": { "extension": "ts", "source": "packages/angular/src/index.ts", "dependencies": ["@floating-ui/dom", "@simurgh-ui/core"] }
  },
  "symbols": {
    "react": {
      "dialog": ["Dialog", "DialogTrigger", "DialogPortal", "DialogOverlay", "DialogContent", "DialogTitle", "DialogDescription", "DialogClose"],
      "popover": ["Popover", "PopoverTrigger", "PopoverContent"],
      "tooltip": ["Tooltip", "TooltipTrigger", "TooltipContent"],
      "dropdown-menu": ["DropdownMenu", "DropdownMenuTrigger", "DropdownMenuContent", "DropdownMenuItem"],
      "select": ["Select"],
      "tabs": ["Tabs", "TabsList", "TabsTrigger", "TabsContent"],
      "accordion": ["Accordion", "AccordionItem", "AccordionTrigger", "AccordionContent"],
      "checkbox": ["Checkbox"],
      "switch": ["Switch"],
      "toast": ["ToastProvider", "useToast", "ToastViewport", "ToastMessage"]
    },
    "vue": {
      "dialog": ["Dialog", "DialogTrigger", "DialogContent", "DialogTitle", "DialogDescription", "DialogClose"],
      "popover": ["Popover", "PopoverTrigger", "PopoverContent"],
      "tooltip": ["Tooltip", "TooltipTrigger", "TooltipContent"],
      "dropdown-menu": ["DropdownMenu", "DropdownMenuTrigger", "DropdownMenuContent", "DropdownMenuItem"],
      "select": ["Select"],
      "tabs": ["Tabs", "TabsList", "TabsTrigger", "TabsContent"],
      "accordion": ["Accordion", "AccordionItem", "AccordionTrigger", "AccordionContent"],
      "checkbox": ["Checkbox"],
      "switch": ["Switch"],
      "toast": ["ToastProvider", "useToast", "ToastViewport", "ToastMessage"]
    },
    "angular": {
      "dialog": ["DialogComponent"],
      "popover": ["PopoverComponent"],
      "tooltip": ["TooltipComponent"],
      "dropdown-menu": ["DropdownMenuComponent", "DropdownMenuItemDirective"],
      "select": ["SelectComponent", "SelectOption"],
      "tabs": ["TabsComponent", "TabDirective", "TabPanelDirective"],
      "accordion": ["AccordionComponent", "AccordionItemComponent"],
      "checkbox": ["CheckboxComponent"],
      "switch": ["SwitchComponent"],
      "toast": ["ToastViewportComponent", "ToastMessage"]
    }
  },
  "shared": { "styles": ["packages/styles/tokens.css", "packages/styles/recipes.css"], "tokens": ["background", "foreground", "surface", "primary", "accent", "danger", "border", "ring"] }
}
