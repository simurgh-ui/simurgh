{
  "name": "@simurgh-ui/styles",
  "version": "0.1.2",
  "description": "Design tokens and optional component recipes for Simurgh UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./recipes.css": "./recipes.css",
    "./all.css": "./all.css",
    "./*.css": "./components/*.css"
  },
  "files": [
    "*.css",
    "components/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-styles.mjs",
    "test": "node ../../scripts/check-component-styles.mjs && node ../../scripts/check-tailwind-token-parity.mjs",
    "typecheck": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\""
  }
}
