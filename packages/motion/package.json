{
  "name": "@simurgh-ui/motion",
  "version": "0.1.1",
  "description": "Framework-neutral motion primitives and adapters for Simurgh UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/motion"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "react": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^20.3.27",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "vitest": "^3.2.7",
    "vue": "^3.5.41"
  }
}
