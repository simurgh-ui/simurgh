{
  "name": "@simurgh-ui/react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@simurgh-ui/core": "workspace:*"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": { "@types/react": "^19.1.16", "@types/react-dom": "^19.1.9", "react": "^19.1.1", "react-dom": "^19.1.1" }
}
