{
  "name": "@simurgh-ui/core",
  "version": "0.1.1",
  "description": "Framework-neutral state and interaction utilities for Simurgh UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./chart-interactions": {
      "types": "./dist/chart-interactions.d.ts",
      "import": "./dist/chart-interactions.js"
    },
    "./chart-stream": {
      "types": "./dist/chart-stream.d.ts",
      "import": "./dist/chart-stream.js"
    },
    "./chart-canvas": {
      "types": "./dist/chart-canvas.d.ts",
      "import": "./dist/chart-canvas.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
