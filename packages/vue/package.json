{
  "name": "@simurgh-ui/vue",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart-interactions": {
      "types": "./dist/chart-interactions.d.ts",
      "import": "./dist/chart-interactions.js"
    },
    "./chart-stream": {
      "types": "./dist/chart-stream.d.ts",
      "import": "./dist/chart-stream.js"
    },
    "./chart-canvas": {
      "types": "./dist/chart-canvas.d.ts",
      "import": "./dist/chart-canvas.js"
    },
    "./chart-motion": {
      "types": "./dist/chart-motion.d.ts",
      "import": "./dist/chart-motion.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs vue && tsc -p tsconfig.json && node ../../scripts/build-adapter.mjs vue",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@simurgh-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "@simurgh-ui/motion": "workspace:*",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@simurgh-ui/motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simurgh-ui/motion": "workspace:*",
    "vue": "^3.5.41"
  }
}
