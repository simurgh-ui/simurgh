{
  "name": "@simurgh-ui/vue",
  "version": "0.1.2",
  "description": "Accessible Simurgh UI components for Vue.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart-interactions": {
      "types": "./dist/chart-interactions.d.ts",
      "import": "./dist/chart-interactions.js"
    },
    "./chart-stream": {
      "types": "./dist/chart-stream.d.ts",
      "import": "./dist/chart-stream.js"
    },
    "./chart-canvas": {
      "types": "./dist/chart-canvas.d.ts",
      "import": "./dist/chart-canvas.js"
    },
    "./chart-motion": {
      "types": "./dist/chart-motion.d.ts",
      "import": "./dist/chart-motion.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs vue && tsc -p tsconfig.json && node ../../scripts/build-adapter.mjs vue",
    "test": "vitest run",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@simurgh-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "@simurgh-ui/motion": "workspace:*",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@simurgh-ui/motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@simurgh-ui/motion": "workspace:*",
    "@vue/server-renderer": "3.5.41",
    "vue": "^3.5.41"
  }
}
