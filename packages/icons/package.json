{
  "name": "@simurgh-ui/icons",
  "version": "0.1.0",
  "description": "Tree-shakeable Simurgh icons for React, Vue, Angular, and raw SVG use.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/dynamic": {
      "types": "./dist/react-dynamic.d.ts",
      "import": "./dist/react-dynamic.js"
    },
    "./react/*": {
      "types": "./dist/react-icons/*.d.ts",
      "import": "./dist/react-icons/*.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./vue/dynamic": {
      "types": "./dist/vue-dynamic.d.ts",
      "import": "./dist/vue-dynamic.js"
    },
    "./vue/*": {
      "types": "./dist/vue-icons/*.d.ts",
      "import": "./dist/vue-icons/*.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "default": "./dist/angular.js"
    },
    "./angular/dynamic": {
      "types": "./dist/angular-dynamic.d.ts",
      "default": "./dist/angular-dynamic.js"
    },
    "./angular/*": {
      "types": "./dist/angular-icons/*.d.ts",
      "default": "./dist/angular-icons/*.js"
    },
    "./svg/*": "./svg/*.svg"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "svg",
    "README.md"
  ],
  "scripts": {
    "generate": "node ../../scripts/generate-icons.mjs",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "test": "node ../../scripts/check-icon-catalog-integrity.mjs && node ../../scripts/check-icon-optical-quality.mjs && node ../../scripts/generate-icon-optical-review.mjs --check && node ../../scripts/check-icon-context-contrast.mjs && node ../../scripts/measure-icon-import-strategies.mjs --check && vitest run && node ../../scripts/check-icons-bundle-size.mjs",
    "size": "node ../../scripts/check-icons-bundle-size.mjs",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "react": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.7",
    "vue": "^3.5.41",
    "zone.js": "^0.15.1"
  }
}
