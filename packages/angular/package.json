{
  "name": "@simurgh-ui/angular",
  "version": "0.3.2-beta.1",
  "description": "Accessible Simurgh UI components for Angular.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simurgh-ui/simurgh.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/simurgh-ui/simurgh#readme",
  "bugs": {
    "url": "https://github.com/simurgh-ui/simurgh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./chart-interactions": {
      "types": "./dist/chart-interactions.d.ts",
      "default": "./dist/chart-interactions.js"
    },
    "./chart-stream": {
      "types": "./dist/chart-stream.d.ts",
      "default": "./dist/chart-stream.js"
    },
    "./chart-canvas": {
      "types": "./dist/chart-canvas.d.ts",
      "default": "./dist/chart-canvas.js"
    },
    "./chart-export": {
      "types": "./dist/chart-export.d.ts",
      "default": "./dist/chart-export.js"
    },
    "./chart-responsive": {
      "types": "./dist/chart-responsive.d.ts",
      "default": "./dist/chart-responsive.js"
    },
    "./chart-motion": {
      "types": "./dist/chart-motion.d.ts",
      "default": "./dist/chart-motion.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs angular && ngc -p tsconfig.json && node ../../scripts/optimize-angular.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@simurgh-ui/core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": ">=18",
    "@angular/core": ">=18",
    "@simurgh-ui/motion": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@simurgh-ui/motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/platform-server": "20.3.27",
    "@simurgh-ui/motion": "workspace:*",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.1"
  }
}
