{
  "name": "@simurgh-ui/mcp",
  "version": "0.2.0-beta.0",
  "description": "Model Context Protocol server for Simurgh UI component discovery and source retrieval.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "simurgh-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@simurgh-ui/registry": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "^3.2.7"
  }
}
