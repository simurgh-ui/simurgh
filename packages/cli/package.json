{
  "name": "@simurgh-ui/cli",
  "version": "0.3.1",
  "type": "module",
  "bin": {
    "simurgh": "dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/build-assets.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "pnpm build && vitest run",
    "coverage": "vitest run --coverage --config ../../vitest.coverage.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@simurgh-ui/registry": "workspace:*",
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
