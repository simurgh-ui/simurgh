{
  "name": "simurgh-ui",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "generate:entries": "node scripts/generate-entrypoints.mjs && node scripts/generate-styles.mjs",
    "bundle:size": "node scripts/check-bundle-size.mjs && node scripts/check-motion-size.mjs && node scripts/check-angular-production-size.mjs && node scripts/check-lazy-overlay-size.mjs",
    "bundle:react-splitting": "node scripts/analyze-react-code-splitting.mjs",
    "format": "prettier --write .",
    "test:contracts": "vitest run packages/react/test packages/vue/test packages/angular/test packages/cli/test",
    "test:e2e": "playwright test",
    "test:quick-starts": "node scripts/check-package-quick-starts.mjs"
  },
  "devDependencies": {
    "@angular/compiler-cli": "20.3.2",
    "@babel/core": "7.28.3",
    "@changesets/cli": "^2.29.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/vue": "^8.1.0",
    "axe-core": "^4.10.3",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.12",
    "eslint": "^9.36.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
