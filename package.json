{
  "name": "simurgh-ui",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "generate:entries": "node scripts/generate-entrypoints.mjs && node scripts/generate-styles.mjs",
    "bundle:size": "node scripts/check-floating-size.mjs && node scripts/check-bundle-size.mjs && node scripts/check-icons-bundle-size.mjs && node scripts/check-motion-size.mjs && node scripts/check-angular-production-size.mjs && node scripts/check-lazy-overlay-size.mjs",
    "bundle:react-splitting": "node scripts/analyze-react-code-splitting.mjs",
    "chart:performance": "node scripts/benchmark-charts.mjs",
    "changeset": "changeset",
    "format": "prettier --write .",
    "release": "changeset publish",
    "test:contracts": "vitest run packages/react/test packages/vue/test packages/angular/test packages/cli/test",
    "test:e2e": "playwright test",
    "test:quick-starts": "node scripts/check-package-quick-starts.mjs",
    "test:references": "node scripts/check-reference-apps.mjs",
    "test:release": "node scripts/check-release-coherence.mjs && node scripts/check-adapter-boundaries.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@angular/compiler-cli": "20.3.2",
    "@babel/core": "7.28.3",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
