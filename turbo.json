{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "assets/**", "all.css", "components/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build", "build"] },
    "coverage": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": { "dependsOn": ["^build", "build"] },
    "lint": { "dependsOn": ["^build", "build"] }
  }
}
